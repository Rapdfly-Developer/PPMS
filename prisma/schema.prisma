// PPMS - Personal Patient Management System
// Multi-tenant EMR & appointment platform for visiting ophthalmologists

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Identity & tenancy
// ──────────────────────────────────────────────────────────────────────────

// Role: DOCTOR | HOSPITAL | REFRACTIONIST
model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  role          String
  email         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  doctor        Doctor?
  hospitalStaff HospitalStaff?
  refractionist Refractionist?
  auditLogs     AuditLog[]
  notifications Notification[]
  loginHistory  UserLoginHistory[]
  exportOtps         ExportOtp[]
  passwordResetTokens PasswordResetToken[]
}

model Doctor {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  name                String
  shortCode           String?  @unique
  specialty           String   @default("")
  contact             String?
  credentials         String?
  email               String?
  experience          String?
  medicalRegNumber    String?
  qualifications      String?
  signatureUrl        String?
  createdAt           DateTime @default(now())

  hospitalLinks  DoctorHospitalLink[]
  refractionists Refractionist[]
  patients       Patient[]
  appointments   Appointment[]
  visits         Visit[]
  availabilities              DoctorAvailability[]
  monthlyAvailabilities       MonthlyAvailability[]
  individualDayAvailabilities IndividualDayAvailability[]
  leaves                      DoctorLeave[]
  generatedSchedules          GeneratedSchedule[]
  scheduleExceptions          ScheduleException[]
  license                     TenantLicense?
  surgerySchedules            SurgerySchedule[]
  dischargeSummaries          DischargeSummary[]
}

model Hospital {
  id             String   @id @default(cuid())
  name           String
  shortCode      String   @unique
  email          String?
  address        String?
  contact        String?
  logoUrl        String?
  retentionYears Int      @default(7)
  createdAt      DateTime @default(now())

  doctorLinks    DoctorHospitalLink[]
  staff          HospitalStaff[]
  refractionists Refractionist[]
  patients       Patient[]
  appointments   Appointment[]
  visits         Visit[]
  availabilities              DoctorAvailability[]
  monthlyAvailabilities       MonthlyAvailability[]
  individualDayAvailabilities IndividualDayAvailability[]
  leaves                      DoctorLeave[]
  generatedSchedules          GeneratedSchedule[]
  scheduleExceptions          ScheduleException[]
  chipOptions                 ChipOption[]
  integration    HospitalIntegration?
  integrationLogs IntegrationLog[]

  insuranceCompanies InsuranceCompany[]
  patientInsurances  PatientInsurance[]
  preAuths           InsurancePreAuthorization[]
  surgerySchedules   SurgerySchedule[]
  insuranceClaims    InsuranceClaim[]
}

// ──────────────────────────────────────────────────────────────────────────
// Hospital Integration Engine
// PPMS keeps a standard internal clinical data model; each hospital gets an
// adapter + mapping config so new hospitals are onboarded via configuration,
// not core-code changes.
// ──────────────────────────────────────────────────────────────────────────

// integrationType: FHIR | HL7 | REST | CSV
// authType: NONE | API_KEY | BEARER | BASIC | OAUTH2
model HospitalIntegration {
  id                  String   @id @default(cuid())
  hospitalId          String   @unique
  hospital            Hospital @relation(fields: [hospitalId], references: [id])
  integrationType     String   @default("REST")
  apiEndpoint         String?
  authType            String   @default("NONE")
  credentialsEncrypted String? // AES-256-GCM; API key / token / client secret
  oauthTokenUrl       String?  // OAUTH2 only
  fieldMappingJson    String?  // JSON: PPMS field -> hospital field overrides
  transformationRules String?  // JSON: value-level transforms (e.g. sex M/F -> 1/2)
  syncEnabled         Boolean  @default(false)
  maxRetries          Int      @default(3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  logs IntegrationLog[]
}

// status: PENDING | SUCCESS | FAILED
// recordType: VISIT | PATIENT
model IntegrationLog {
  id              String   @id @default(cuid())
  integrationId   String
  integration     HospitalIntegration @relation(fields: [integrationId], references: [id])
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  patientId       String?
  visitId         String?
  recordType      String   @default("VISIT")
  status          String   @default("PENDING")
  requestPayload  String?  // what the adapter produced (truncated)
  responsePayload String?  // hospital ack / error body (truncated)
  errorMessage    String?
  retryCount      Int      @default(0)
  triggeredBy     String?  // AUTO | MANUAL | RETRY
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hospitalId, status])
  @@index([visitId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Licensing & subscriptions
// ──────────────────────────────────────────────────────────────────────────

// paymentStatus: NONE | PENDING | PAID | FAILED
// plan: MONTHLY | YEARLY
// The DOCTOR is the licensee — one license covers the doctor and every
// hospital they operate. (Renamed conceptually from per-hospital tenancy.)
model TenantLicense {
  id                   String    @id @default(cuid())
  doctorId             String    @unique
  doctor               Doctor    @relation(fields: [doctorId], references: [id])

  // 30-day free trial
  trialStartsAt        DateTime  @default(now())
  trialEndsAt          DateTime

  // Paid subscription (null until first payment)
  plan                 String?
  subscriptionStartsAt DateTime?
  subscriptionEndsAt   DateTime?

  // Razorpay
  paymentStatus        String    @default("NONE")
  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?

  // License key activation (offline/manual key)
  licenseKey           String?
  machineId            String?   // browser-generated UUID stored in cookie
  deviceName           String?
  lastVerifiedAt       DateTime?

  // Reminder tracking (bitfield: 1=7day, 2=3day, 4=1day)
  remindersSent        Int       @default(0)

  // HMAC of core license fields — detects out-of-band tampering
  signature            String?

  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([trialEndsAt])
  @@index([subscriptionEndsAt])
}

// Keys minted by the product owner (CLI script or admin card). A key must
// exist here, unused and unrevoked, before activateLicenseKey accepts it.
model IssuedLicenseKey {
  id             String    @id @default(cuid())
  key            String    @unique
  note           String?   // customer name / order reference
  months         Int       @default(12)
  createdAt      DateTime  @default(now())
  usedAt         DateTime?
  usedByDoctorId String?
  revoked        Boolean   @default(false)

  @@index([usedAt])
}

// License activation audit trail shown on /license/activate
model LicenseEvent {
  id          String   @id @default(cuid())
  doctorId    String
  action      String   // TRIAL_STARTED | ACTIVATED | REACTIVATED | VERIFIED
  keyMasked   String?
  performedBy String?
  status      String   // SUCCESS | FAILED
  detail      String?
  createdAt   DateTime @default(now())

  @@index([doctorId, createdAt])
}

// Scoped login for a Hospital, linked to exactly one Doctor-Hospital relationship
model HospitalStaff {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  name       String
  mobile     String?
  createdAt  DateTime @default(now())

  @@index([hospitalId])
}

model DoctorHospitalLink {
  id         String   @id @default(cuid())
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  active     Boolean  @default(true)

  @@unique([doctorId, hospitalId])
  @@index([hospitalId])
}

model Refractionist {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  name       String
  mobile     String?
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  createdAt  DateTime @default(now())
}

// ── Availability types ──────────────────────────────────────────────────────

// Weekly recurring slots — lowest priority base schedule
model DoctorAvailability {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  weekday     Int      // 0=Sun … 6=Sat
  startTime   String   // "HH:MM" 24h
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
}

// Monthly plan — overrides weekly; e.g. "Every Mon-Fri in Aug at Hospital A, 9-1 PM"
model MonthlyAvailability {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  validFrom   DateTime // start of validity period
  validTo     DateTime // end of validity period
  weekdays    String   // comma-separated day indices: "1,2,3,4,5" = Mon–Fri
  startTime   String   // "HH:MM" 24h
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  label       String?  // e.g. "Morning OPD August"
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  @@index([doctorId, hospitalId])
}

// Individual date override — overrides weekly + monthly
model IndividualDayAvailability {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  date        DateTime // specific calendar date (time part ignored)
  startTime   String
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  reason      String?  // e.g. "Special Camp", "Half Day"
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  @@index([doctorId, hospitalId, date])
}

// Generated monthly schedule — produced by "Generate Month" from the weekly template
model GeneratedSchedule {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  date        DateTime
  hospitalId  String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  startTime   String
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  isModified  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([doctorId, date])
}

// Schedule exceptions — leave, extra OP, recurring half-day blocks, etc.
model ScheduleException {
  id               String    @id @default(cuid())
  doctorId         String
  doctor           Doctor    @relation(fields: [doctorId], references: [id])
  date             DateTime
  type             String    // LEAVE | EXTRA_OP | HOLIDAY
  hospitalId       String?   // null = all hospitals
  hospital         Hospital? @relation(fields: [hospitalId], references: [id])
  startTime        String?
  endTime          String?
  slotMins         Int?
  maxPatients      Int?
  reason           String?
  halfPeriod       String?   // MORNING | AFTERNOON
  isRecurring      Boolean   @default(false)
  recurringGroupId String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())

  @@index([doctorId, date])
}

// Leave — highest priority; blocks all slots on the date
model DoctorLeave {
  id         String    @id @default(cuid())
  doctorId   String
  doctor     Doctor    @relation(fields: [doctorId], references: [id])
  hospitalId String?   // null = all hospitals
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  date       DateTime  // calendar date of leave
  leaveType  String    @default("FULL_DAY") // FULL_DAY | HALF_DAY
  halfPeriod String?   // MORNING | AFTERNOON (only for HALF_DAY)
  reason     String?
  status     String    @default("APPROVED") // APPROVED | CANCELLED
  createdAt  DateTime  @default(now())

  @@index([doctorId, date])
}

// ──────────────────────────────────────────────────────────────────────────
// Patients & appointments
// ──────────────────────────────────────────────────────────────────────────

// Sex: MALE | FEMALE | OTHER
model Patient {
  id              String   @id @default(cuid())
  uhid            String?  @unique // Hospital-based ID: PPMS-{HOSPITALCODE}-NNNN (nullable for legacy)
  udid            String?  @unique // Doctor-based ID:   PPMS-{DOCTORCODE}-NNNN
  doctorId        String?
  doctor          Doctor?  @relation(fields: [doctorId], references: [id])
  registeredAtId  String?
  registeredAt    Hospital? @relation(fields: [registeredAtId], references: [id])
  name            String
  age             Int
  sex             String
  mobile          String
  aadhaarEncrypted String  // encrypted at rest; masked in UI except for Doctor
  category        String   @default("GENERAL") // GENERAL | BPL | SUBSIDISED | ECHS | INSURANCE
  address         String?
  city            String?
  state           String?
  pincode         String?
  complaint       String?
  occupation      String?
  notes           String?
  photoUrl        String?
  aadhaarPhotoUrl String?  // uploaded Aadhaar card scan (blob storage file name)
  createdAt       DateTime @default(now())

  appointments    Appointment[]
  visits          Visit[]
  pastExternalVisits PastExternalVisit[]
  insurancePolicies  PatientInsurance[]
  surgerySchedules   SurgerySchedule[]

  @@index([doctorId])
  @@index([registeredAtId])
  @@index([createdAt])
  @@index([mobile])
  @@index([category])
}

// AppointmentStatus: REQUESTED | CONFIRMED | RESCHEDULED | COMPLETED | CANCELLED | NO_SHOW
model Appointment {
  id         String            @id @default(cuid())
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  doctorId   String?
  doctor     Doctor?           @relation(fields: [doctorId], references: [id])
  hospitalId String
  hospital   Hospital          @relation(fields: [hospitalId], references: [id])
  dateTime   DateTime
  visitType  String            @default("General OPD")
  status             String   @default("REQUESTED")
  consultationStatus String?  // FINALIZED | null
  completedAt        DateTime?
  completedBy        String?  // Doctor name
  isWalkIn           Boolean  @default(false)
  notes              String?
  partialDispenseReason String?
  partialDispenseAt     DateTime?  // set when status → PARTIAL_DISPENSE
  createdAt          DateTime @default(now())
  arrivedAt          DateTime?   // set when status → CONFIRMED (patient reached the clinic)

  visit      Visit?

  @@index([doctorId, dateTime])
  @@index([hospitalId, dateTime])
  @@index([patientId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────
// Visit (parent record for one consultation encounter)
// ──────────────────────────────────────────────────────────────────────────

model Visit {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  date          DateTime @default(now())
  status        String   @default("IN_PROGRESS") // IN_PROGRESS | CLOSED
  visitType     String   @default("General OPD")
  finalizedAt   DateTime?
  finalizedBy   String?  // Doctor name at time of finalization
  sentToPharmacy Boolean @default(false)
  followUpDate   DateTime?
  referralEnabled Boolean @default(false)
  referralNote   String?
  adviseNotes    String?
  anesthesiaType      String?
  procedureLaterality String?
  procedureName       String?
  inViewOf            String?
  followUpCompleted   Boolean   @default(false)
  followUpCancelledAt DateTime?
  gonioNotes          String?  // JSON: { re: string, le: string }

  generalExam        GeneralExamination?
  medications        Medication[]
  visualAcuity       VisualAcuity?
  refraction         RefractiveCorrection?
  colourVisionCS     ColourVisionContrastSensitivity?
  iopReadings        IOPReading[]
  anteriorSegment    AnteriorSegment?
  posteriorSegment   PosteriorSegment?
  diplopiaChart      DiplopiaChart?
  hessChart          HessChart?
  retinoscopy        Retinoscopy?
  tearFilm           TearFilm?
  lacrimalSac        LacrimalSacSyringing?
  investigationOrders InvestigationOrder[]
  diagnoses          Diagnosis[]
  dispense           Dispense?
  admission          Admission?
  surgicalCounselling SurgicalCounselling?

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([followUpDate])
  @@index([status, date])
}

// ──────────────────────────────────────────────────────────────────────────
// General Examination
// ──────────────────────────────────────────────────────────────────────────

model GeneralExamination {
  id                  String   @id @default(cuid())
  visitId             String   @unique
  visit               Visit    @relation(fields: [visitId], references: [id])
  bp                  String?
  pulse                String?
  temperature         String?
  weight              String?
  chiefComplaint      String?
  hpi                 String?
  provisionalDx       String?
  pastMedicalHistory  String? // JSON array of chip values, cumulative
  pmhOtherText        String?
  medications         String? // free text list
  allergies           String?
  nkda                Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────
// Plan - Prescription (dispensed/prescribed drugs for this visit, distinct
// from GeneralExamination.medications which records the patient's reported
// ongoing medications at intake)
// ──────────────────────────────────────────────────────────────────────────

model Medication {
  id           String   @id @default(cuid())
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id])
  drugName     String
  dosage       String?
  frequency    String?
  duration     String?
  instructions String?
  route        String?
  laterality   String?
  createdAt    DateTime @default(now())

  @@index([visitId])
}

// ──────────────────────────────────────────────────────────────────────────
// Past External Visits (OCR ingestion)
// ──────────────────────────────────────────────────────────────────────────

// VerificationStatus: PENDING_REVIEW | VERIFIED | REJECTED
model PastExternalVisit {
  id                 String              @id @default(cuid())
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id])
  sourceDate         DateTime?
  sourceHospital     String?
  extractedDiagnosis String?
  extractedTreatment String?
  scanFileRef        String?
  label              String?
  verificationStatus String              @default("PENDING_REVIEW")
  createdAt          DateTime            @default(now())

  @@index([patientId])
}

// ──────────────────────────────────────────────────────────────────────────
// Ophthalmic Examination sub-modules (RE/LE captured as JSON per eye)
// ──────────────────────────────────────────────────────────────────────────

model VisualAcuity {
  id               String   @id @default(cuid())
  visitId          String   @unique
  visit            Visit    @relation(fields: [visitId], references: [id])
  testMethod       String?  // Snellen | E-chart | LogMAR | Symbols | HOTV
  re               String?  // JSON: { distanceUnaided, distancePinhole, distanceBestCorrected, nearUnaided, nearPinhole, nearBestCorrected }
  le               String?
  reviewedByDoctor Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model RefractiveCorrection {
  id               String   @id @default(cuid())
  visitId          String   @unique
  visit            Visit    @relation(fields: [visitId], references: [id])
  re               String?  // JSON: { distance: {sph,cyl,axis,va}, near: {sph,cyl,axis,va} }
  le               String?
  extraCorrections String?  // JSON: [{label,re,le}] for additional corrections beyond the first
  sentToOpticals   Boolean  @default(false)
  reviewedByDoctor Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model ColourVisionContrastSensitivity {
  id               String   @id @default(cuid())
  visitId          String   @unique
  visit            Visit    @relation(fields: [visitId], references: [id])
  re               String?  // JSON: { ishihara, d15, lanthonyD15, hrr, cityUniv, pelliRobson, marsLetterCS, vistech, fact }
  le               String?
  reviewedByDoctor Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model IOPReading {
  id               String   @id @default(cuid())
  visitId          String
  visit            Visit    @relation(fields: [visitId], references: [id])
  re               Float?
  le               Float?
  method           String?  // NCT | Goldmann | ...
  takenAt          DateTime @default(now())
  source           String   @default("DOCTOR") // DOCTOR | REFRACTIONIST
  reviewedByDoctor Boolean  @default(false)

  @@index([visitId])
}

model AnteriorSegment {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  re        String?  // JSON: { upperLid, lowerLid, conjunctiva, sclera, cornea, anteriorChamber, iris, pupil, lens, freeText }
  le        String?
  updatedAt DateTime @updatedAt
}

model PosteriorSegment {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  re        String?  // JSON: { media, discSize, discShape, discColour, discVessels, cdr, nrr, macula, retinalVessels, periphery }
  le        String?
  notes     String?
  updatedAt DateTime @updatedAt
}

model DiplopiaChart {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  grid      String   // JSON map of 9 positions -> { status: NOT_TESTED|NO_DIPLOPIA|DIPLOPIA_PRESENT, notes }
  updatedAt DateTime @updatedAt
}

model HessChart {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  grid      String   // JSON map of 9 positions -> { reH, reV, leH, leV }
  interpretation String?
  updatedAt DateTime @updatedAt
}

model Retinoscopy {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  re        String?
  le        String?
  updatedAt DateTime @updatedAt
}

model TearFilm {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  tbutRe    Float?
  tbutLe    Float?
  schirmer1Re Float?
  schirmer1Le Float?
  schirmer2Re Float?
  schirmer2Le Float?
  updatedAt DateTime @updatedAt
}

model LacrimalSacSyringing {
  id        String   @id @default(cuid())
  visitId   String   @unique
  visit     Visit    @relation(fields: [visitId], references: [id])
  re        String?  // JSON chips + free text
  le        String?
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────
// Investigations & Assessment
// ──────────────────────────────────────────────────────────────────────────

// OrderPriority: ROUTINE | URGENT | STAT
// OrderStatus: ORDERED | IN_PROGRESS | RESULT_AVAILABLE | REVIEWED
model InvestigationOrder {
  id         String        @id @default(cuid())
  visitId    String
  visit      Visit         @relation(fields: [visitId], references: [id])
  category   String        // Imaging & Functional Tests | Pre-op & Lab
  testName   String
  priority   String        @default("ROUTINE")
  laterality String?       // RE | LE | OU
  notes      String?
  status     String        @default("ORDERED")
  resultRef  String?
  createdAt  DateTime      @default(now())

  @@index([visitId])
}

// DiagnosisStatus: ACTIVE | RESOLVED | CHRONIC
model Diagnosis {
  id          String          @id @default(cuid())
  visitId     String
  visit       Visit           @relation(fields: [visitId], references: [id])
  icd10Code   String
  description String
  status      String          @default("ACTIVE")
  laterality  String?         // RE | LE | OU
  provisional Boolean         @default(false)
  // Null until the doctor confirms the diagnosis. Rejecting deletes the row,
  // so there is no explicit REJECTED state to store.
  confirmedAt DateTime?
  // Treatment preset ("protocol") chosen at confirmation. protocolName is
  // denormalised because presets live in localStorage, so another device
  // cannot resolve protocolId back to a label.
  protocolId   String?
  protocolName String?
  createdAt   DateTime        @default(now())

  @@index([visitId])
}

// ──────────────────────────────────────────────────────────────────────────
// Disposition
// ──────────────────────────────────────────────────────────────────────────

model Dispense {
  id           String   @id @default(cuid())
  visitId      String   @unique
  visit        Visit    @relation(fields: [visitId], references: [id])
  shortSummary String
  longSummaryUrl String?
  createdAt    DateTime @default(now())
}

model Admission {
  id                  String    @id @default(cuid())
  visitId             String    @unique
  visit               Visit     @relation(fields: [visitId], references: [id])
  reason              String
  ward                String
  numberOfDays        Int
  discharged          Boolean   @default(false)
  dischargedAt        DateTime?
  dischargeCondition  String?   // STABLE | IMPROVED | AGAINST_ADVICE | TRANSFERRED
  createdAt           DateTime  @default(now())

  preAuths            InsurancePreAuthorization[]
  insuranceClaims     InsuranceClaim[]
  dischargeSummary    DischargeSummary?
}

// conditionAtDischarge: STABLE | IMPROVED | AGAINST_ADVICE | TRANSFERRED
model DischargeSummary {
  id                    String    @id @default(cuid())
  admissionId           String    @unique
  admission             Admission @relation(fields: [admissionId], references: [id])
  doctorId              String
  doctor                Doctor    @relation(fields: [doctorId], references: [id])

  // Surgery recap
  surgeryPerformed      String?
  operatingEye          String?   // RE | LE | BE
  anesthesiaUsed        String?
  iolDetails            String?

  // Clinical outcome
  postOpDiagnosis       String?
  intraopComplications  String?
  postOpCourse          String?
  conditionAtDischarge  String    @default("STABLE")

  // Discharge instructions
  dischargeMedications  String?   // JSON — [{drugName,dosage,frequency,duration,instructions}]
  dischargeInstructions String?
  activityRestrictions  String?
  dietAdvice            String?
  woundCareInstructions String?

  // Follow-up
  followUpDate          DateTime?
  followUpInstructions  String?

  // Dates (captured from Admission.visit.date + dischargedAt)
  admissionDate         DateTime?
  dischargeDate         DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SurgicalCounselling {
  id                String   @id @default(cuid())
  visitId           String   @unique
  visit             Visit    @relation(fields: [visitId], references: [id])
  surgeryName       String?
  surgeryType       String
  rightEye          Boolean  @default(false)
  leftEye           Boolean  @default(false)
  anaesthesiaType   String
  surgeryDate       DateTime
  conflictFlag      Boolean  @default(false)
  insuranceType     String?
  counselingDone    Boolean  @default(false)
  investigationDone Boolean  @default(false)
  fitForSurgery     Boolean?
  // Extended counselling fields (filled via surgical counselling page)
  paymentNotes      String?
  advanceAmount     Float?
  advanceReceipt    String?
  counsellingNotes  String?
  // Doctor review workflow
  reviewStatus      String?   // PENDING_REVIEW | FIT_FOR_SURGERY | NOT_FIT | DEFERRED | ADDITIONAL_INVESTIGATIONS | CONFIRMED
  doctorReviewNote  String?
  doctorReviewedAt  DateTime?
  confirmedFitAt    DateTime?
  createdAt         DateTime @default(now())

  // Optional additive workflow layer (see CounsellingWorkflow). Records created
  // before the workflow module shipped simply have no row here and behave exactly
  // as before.
  workflow          CounsellingWorkflow?
}

// ──────────────────────────────────────────────────────────────────────────
// Audit trail
// ──────────────────────────────────────────────────────────────────────────

// ──────────────────────────────────────────────────────────────────────────
// In-app notifications
// ──────────────────────────────────────────────────────────────────────────

// NotificationType: APPOINTMENT_REQUESTED | APPOINTMENT_CONFIRMED | APPOINTMENT_RESCHEDULED
//                   APPOINTMENT_CANCELLED | PATIENT_ADMITTED | GENERAL
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  entityId  String?  // optional reference (appointmentId, visitId, etc.)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  timestamp  DateTime @default(now())

  // Extended fields for richer audit context
  hospitalId String?
  moduleName String?
  actionType String?   // CREATE | UPDATE | DELETE | VIEW | PRINT | DOWNLOAD
  ipAddress  String?
  userName   String?

  @@index([userId, timestamp])
  @@index([hospitalId, timestamp])
  @@index([entityType, entityId])
}

// ──────────────────────────────────────────────────────────────────────────
// Login & session tracking
// ──────────────────────────────────────────────────────────────────────────

model UserLoginHistory {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  userName     String
  role         String
  hospitalId   String?
  hospitalName String?
  loginAt      DateTime  @default(now())
  logoutAt     DateTime?
  ipAddress    String?
  userAgent    String?
  status       String    @default("SUCCESS")  // SUCCESS | FAILED
  isActive     Boolean   @default(true)
  failReason   String?

  @@index([userId, loginAt])
  @@index([status, loginAt])
  @@index([isActive])
}

// ──────────────────────────────────────────────────────────────────────────
// Email Verification OTP — for trial registration email confirmation
// ──────────────────────────────────────────────────────────────────────────

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ──────────────────────────────────────────────────────────────────────────
// Export OTP — short-lived codes for authorising data downloads
// ──────────────────────────────────────────────────────────────────────────

model ExportOtp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// Short-lived OTP record for mobile-number login
model MobileOtp {
  id         String    @id @default(cuid())
  mobile     String
  otpHash    String
  loginToken String?   @unique  // set after OTP verified; used to complete sign-in
  tokenExpAt DateTime?           // 5 min window to exchange token → session
  expiresAt  DateTime
  used       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  email      String
  otpHash    String
  resetToken String?   @unique  // populated after OTP verified; used in final step
  expiresAt  DateTime            // OTP expires 5 min after creation
  tokenExpAt DateTime?           // resetToken expires 10 min after OTP verify
  usedAt     DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([resetToken])
}

// ──────────────────────────────────────────────────────────────────────────
// RBAC — granular permissions per role
// ──────────────────────────────────────────────────────────────────────────

model Role {
  id                 String   @id @default(cuid())
  name               String   @unique   // matches User.role string e.g. "HOSPITAL"
  label              String             // "Hospital Admin"
  description        String?
  isSystem           Boolean  @default(false)   // DOCTOR/HOSPITAL/REFRACTIONIST locked
  isActive           Boolean  @default(true)
  color              String   @default("#6366f1")
  createdAt          DateTime @default(now())
  createdByDoctorId  String?            // null = system role; set = doctor-scoped custom role
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique  // e.g. "patients.view", "emr.edit"
  label String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String     // "DOCTOR" | "HOSPITAL" | "REFRACTIONIST"
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

// Configurable chip/dropdown values per hospital (or global when hospitalId is null)
// category examples: "PMH", "VISIT_TYPE", "INVESTIGATION_TYPE"
model ChipOption {
  id         String    @id @default(cuid())
  category   String
  value      String
  label      String
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@unique([category, value, hospitalId])
  @@index([category, hospitalId])
}

// ──────────────────────────────────────────────────────────────────────────
// Billing & Insurance Module
// ──────────────────────────────────────────────────────────────────────────

model InsuranceCompany {
  id            String   @id @default(cuid())
  hospitalId    String
  hospital      Hospital @relation(fields: [hospitalId], references: [id])
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  tpaName       String?  // Third-party administrator, if any
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patientInsurances PatientInsurance[]
  preAuths          InsurancePreAuthorization[]
  claims            InsuranceClaim[]

  @@index([hospitalId, active])
}

// PatientInsurance.status: ACTIVE | EXPIRED | SUSPENDED
model PatientInsurance {
  id                 String   @id @default(cuid())
  hospitalId         String
  hospital           Hospital @relation(fields: [hospitalId], references: [id])
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id])
  insuranceCompanyId String
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  policyNumber       String
  cardNumber         String?
  coveragePercent    Float    @default(80)
  validFrom          DateTime
  validTo            DateTime
  status             String   @default("ACTIVE")
  cardImageUrl       String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  preAuths InsurancePreAuthorization[]
  claims   InsuranceClaim[]

  @@index([hospitalId, patientId])
  @@index([status])
}

// InsurancePreAuthorization.status: PENDING | APPROVED | REJECTED | QUERY_RAISED
model InsurancePreAuthorization {
  id                 String   @id @default(cuid())
  hospitalId         String
  hospital           Hospital @relation(fields: [hospitalId], references: [id])
  admissionId        String?
  admission          Admission? @relation(fields: [admissionId], references: [id])
  patientInsuranceId String
  patientInsurance   PatientInsurance @relation(fields: [patientInsuranceId], references: [id])
  insuranceCompanyId String
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  diagnosis          String
  plannedSurgery     String?
  estimatedCost      Float
  requestedAmount    Float
  approvedAmount     Float?
  authCode           String?
  status             String   @default("PENDING")
  notes              String?
  submittedAt        DateTime?
  respondedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  claim InsuranceClaim?

  @@index([hospitalId, status])
}

// InsuranceClaim.status:
//   CREATED | DOCUMENTS_UPLOADED | PRE_AUTH_SENT | PRE_AUTH_APPROVED |
//   TREATMENT_COMPLETED | BILL_PREPARED | CLAIM_SUBMITTED |
//   UNDER_REVIEW | QUERY_RAISED | APPROVED | REJECTED |
//   PAYMENT_RECEIVED | CLOSED
model InsuranceClaim {
  id                    String   @id @default(cuid())
  claimNumber           String   @unique
  hospitalId            String
  hospital              Hospital @relation(fields: [hospitalId], references: [id])
  patientInsuranceId    String
  patientInsurance      PatientInsurance @relation(fields: [patientInsuranceId], references: [id])
  insuranceCompanyId    String
  insuranceCompany      InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  preAuthId             String?  @unique
  preAuth               InsurancePreAuthorization? @relation(fields: [preAuthId], references: [id])
  admissionId           String?
  admission             Admission? @relation(fields: [admissionId], references: [id])

  // Bill breakdown (all amounts in hospital's currency)
  roomCharges           Float    @default(0)
  surgeryCharges        Float    @default(0)
  pharmacyCharges       Float    @default(0)
  labCharges            Float    @default(0)
  miscCharges           Float    @default(0)
  totalBillAmount       Float    @default(0)

  // Settlement
  approvedAmount        Float?
  patientResponsibility Float?

  status                String   @default("CREATED")
  submittedAt           DateTime?
  approvedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  documents   InsuranceClaimDocument[]
  settlements InsuranceSettlement[]
  queries     InsuranceQuery[]
  payments    InsurancePayment[]

  @@index([hospitalId, status])
  @@index([claimNumber])
}

// InsuranceClaimDocument.docType:
//   INSURANCE_CARD | PATIENT_ID | ADMISSION_FORM | DOCTORS_NOTES |
//   INVESTIGATION_REPORTS | CONSENT_FORM | OPERATION_NOTES |
//   DISCHARGE_SUMMARY | FINAL_BILL | PHARMACY_BILL | IMPLANT_INVOICE | OTHER
model InsuranceClaimDocument {
  id         String   @id @default(cuid())
  claimId    String
  claim      InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  docType    String
  fileName   String
  fileUrl    String
  uploadedBy String   // userId
  uploadedAt DateTime @default(now())

  @@index([claimId])
}

model InsuranceSettlement {
  id              String   @id @default(cuid())
  claimId         String
  claim           InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  settledAmount   Float
  settledDate     DateTime
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())

  payments InsurancePayment[]

  @@index([claimId])
}

// InsurancePayment.paymentMode: BANK_TRANSFER | CHEQUE | NEFT | RTGS | CASH
model InsurancePayment {
  id              String   @id @default(cuid())
  claimId         String
  claim           InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  settlementId    String?
  settlement      InsuranceSettlement? @relation(fields: [settlementId], references: [id])
  amount          Float
  paymentDate     DateTime
  paymentMode     String   @default("BANK_TRANSFER")
  referenceNumber String?
  notes           String?
  postedBy        String   // userId
  createdAt       DateTime @default(now())

  @@index([claimId])
}

// InsuranceQuery.queryBy: INSURER | HOSPITAL
// InsuranceQuery.status: OPEN | RESPONDED | CLOSED
model InsuranceQuery {
  id           String    @id @default(cuid())
  claimId      String
  claim        InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  queryBy      String    @default("INSURER")
  queryText    String
  responseText String?
  status       String    @default("OPEN")
  raisedAt     DateTime  @default(now())
  respondedAt  DateTime?

  @@index([claimId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// OT Room Workflow  (created by doctor on entering the OT)
// status: CHECKIN | PREP | IN_PROGRESS | COMPLETED | RECOVERY
// ──────────────────────────────────────────────────────────────────────────
model OtRecord {
  id                String   @id @default(cuid())
  surgeryScheduleId String   @unique
  surgerySchedule   SurgerySchedule @relation(fields: [surgeryScheduleId], references: [id])

  // Step 1 — Patient Check-in
  checkInTime                 DateTime?
  identityVerified            Boolean  @default(false)
  correctEyeVerified          Boolean  @default(false)
  surgeryTypeVerified         Boolean  @default(false)
  consentFormsVerified        Boolean  @default(false)
  implantAvailabilityVerified Boolean  @default(false)

  // Step 2 — OT Preparation
  assistantSurgeon            String?
  anesthetist                 String?
  scrubNurse                  String?
  circulatingNurse            String?
  anesthesiaTypeRecorded      String?
  whoSignIn                   String?  // JSON: boolean map of checklist items

  // Step 3 — Surgery Start
  surgeryStartTime            DateTime?

  // Step 4 — Intra-Operative
  procedurePerformed          String?
  iolModel                    String?
  iolPower                    String?
  iolBatch                    String?
  iolSerial                   String?
  medicinesConsumed           String?
  intraopFindings             String?
  complications               String?
  intraopRemarks              String?

  // Step 5 — Surgery Completion
  surgeryEndTime              DateTime?
  operativeNotes              String?

  // Step 6 — Recovery Transfer
  patientConditionOnTransfer  String?
  transferTime                DateTime?

  status                      String   @default("CHECKIN")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  timeline  OtTimeline[]
}

// Immutable timestamped audit trail for the OT workflow
model OtTimeline {
  id          String   @id @default(cuid())
  otRecordId  String
  otRecord    OtRecord @relation(fields: [otRecordId], references: [id])
  step        String   // CHECKIN | PREP | SURGERY_START | INTRAOP | COMPLETED | RECOVERY
  action      String
  performedBy String
  performedAt DateTime @default(now())

  @@index([otRecordId, performedAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Surgery Scheduling (created by hospital admin from Scheduled OT)
// status: PLANNED | SCHEDULED | RESCHEDULED | CANCELLED
// ──────────────────────────────────────────────────────────────────────────
model SurgerySchedule {
  id                    String    @id @default(cuid())
  surgicalCounsellingId String?
  patientId             String
  patient               Patient   @relation(fields: [patientId], references: [id])
  hospitalId            String
  hospital              Hospital  @relation(fields: [hospitalId], references: [id])
  operatingSurgeonId    String
  surgeon               Doctor    @relation(fields: [operatingSurgeonId], references: [id])

  department            String?
  surgeryName           String
  diagnosis             String?
  procedure             String?
  surgeryCategory       String              // MAJOR | MINOR
  urgencyType           String              // ELECTIVE | EMERGENCY
  priority              String              // ROUTINE | URGENT | EMERGENCY

  plannedDateTime       DateTime
  otRoom                String?
  estimatedDuration     Int?                // minutes

  anesthetistName       String?
  nursingStaff          String?

  admissionDate         DateTime?
  paymentStatus         String?

  consentReceived       Boolean   @default(false)
  reportsUploaded       Boolean   @default(false)
  otAvailable           Boolean   @default(false)
  bloodArranged         Boolean   @default(false)
  patientInformed       Boolean   @default(false)

  status                String    @default("PLANNED")
  caseStatus            String?   // OPEN | CLOSED
  caseClosedAt          DateTime?
  remarks               String?

  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  otRecord              OtRecord?

  @@index([hospitalId, plannedDateTime])
  @@index([patientId])
}

// Records that a later-added permission has already been auto-granted to a role
// once, so the backfill never re-grants something an admin deliberately revoked.
model RolePermissionSeed {
  id            String   @id @default(cuid())
  role          String
  permissionKey String
  seededAt      DateTime @default(now())

  @@unique([role, permissionKey])
}

// ──────────────────────────────────────────────────────────────────────────
// Surgical Counselling Workflow — additive layer over SurgicalCounselling.
//
// This module wraps the existing surgery flow rather than replacing it. A
// SurgicalCounselling row with no CounsellingWorkflow behaves exactly as it did
// before this module shipped, so historic records and the legacy counselling
// screens keep working untouched.
//
// stage: PENDING_COUNSELING | COUNSELING_COMPLETED | AWAITING_DOCTOR_REVIEW
//        FIT_FOR_SURGERY | NOT_FIT | DEFERRED | ADDITIONAL_INVESTIGATIONS
//        CONFIRMATION_COUNSELING | READY_FOR_OT | OT_SLOT_REQUESTED
//        RESCHEDULING_REQUIRED | SCHEDULED_OT | CANCELLED
// ──────────────────────────────────────────────────────────────────────────
model CounsellingWorkflow {
  id                     String   @id @default(cuid())
  surgicalCounsellingId  String   @unique
  surgicalCounselling    SurgicalCounselling @relation(fields: [surgicalCounsellingId], references: [id])

  stage                  String   @default("PENDING_COUNSELING")

  // ── Stage 1 — initial counselling capture ──
  eyeLaterality          String?   // RE | LE | OU
  diagnosisText          String?
  procedureExplanation   String?
  benefits               String?
  risks                  String?
  recoveryInfo           String?
  patientQuestions       String?
  estimatedCost          Float?
  paymentMode            String?   // CASH | INSURANCE | GOVT_SCHEME | CAMP | OTHER
  insuranceApproval      String?   // NA | PENDING | APPROVED | REJECTED
  packageStatus          String?   // PENDING | PARTIAL | PAID
  requiredInvestigations String?
  investigationStatus    String?   // PENDING | PARTIAL | COMPLETED
  consentStatus          String?   // PENDING | OBTAINED
  counsellingNotes       String?
  counselledBy           String?   // userId
  counselledByName       String?
  counselledAt           DateTime?

  // ── Stage 2 — doctor clinical decision ──
  decision               String?   // FIT | NOT_FIT | DEFERRED | ADDITIONAL_INVESTIGATIONS
  decisionReason         String?
  decisionInvestigations String?
  decidedBy              String?   // userId
  decidedByName          String?
  decidedAt              DateTime?

  // ── Stage 3 — confirmation counselling ──
  confirmedSections      String?   // JSON array of verified section keys
  confirmationNotes      String?
  patientReady           Boolean   @default(false)
  consentConfirmed       Boolean   @default(false)
  confirmedBy            String?   // userId
  confirmedByName        String?
  confirmedAt            DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  versions               CounsellingVersion[]
  otSlotRequests         OtSlotRequest[]

  @@index([stage])
}

// Immutable snapshot written on every counselling / decision / confirmation
// change so the module carries its own version history independent of AuditLog.
model CounsellingVersion {
  id            String   @id @default(cuid())
  workflowId    String
  workflow      CounsellingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stage         String
  changeType    String   // COUNSELING | DECISION | CONFIRMATION | OT_REQUEST | OT_DECISION
  changedBy     String   // userId
  changedByName String?
  snapshot      String   // JSON payload of the values at this point
  note          String?
  createdAt     DateTime @default(now())

  @@index([workflowId, createdAt])
}

// OT slot request + doctor approval loop that sits in front of the existing
// SurgerySchedule record. Once the doctor approves, the linked SurgerySchedule
// is driven to SURGERY_CONFIRMED and the existing OT flow continues unchanged.
// status: REQUESTED | APPROVED | RESCHEDULE_SUGGESTED | REJECTED | CANCELLED
model OtSlotRequest {
  id                String   @id @default(cuid())
  workflowId        String
  workflow          CounsellingWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  surgeryScheduleId String?

  hospitalId        String
  otRoom            String?
  requestedDate     DateTime
  timeSlot          String?
  doctorId          String
  surgeryName       String
  equipment         String?
  staff             String?
  notes             String?

  status            String   @default("REQUESTED")
  doctorNote        String?
  suggestedDateTime DateTime?
  respondedBy       String?
  respondedAt       DateTime?

  requestedBy       String   // userId
  requestedByName   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workflowId])
  @@index([status])
  @@index([doctorId, status])
}
