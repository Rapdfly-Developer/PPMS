generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnteriorSegment {
  id        String   @id
  visitId   String   @unique
  re        String?
  le        String?
  updatedAt DateTime
  Visit     Visit    @relation(fields: [visitId], references: [id])
}

model Appointment {
  id                    String    @id
  patientId             String
  doctorId              String?
  hospitalId            String
  dateTime              DateTime
  visitType             String    @default("General OPD")
  status                String    @default("REQUESTED")
  isWalkIn              Boolean   @default(false)
  notes                 String?
  createdAt             DateTime  @default(now())
  completedAt           DateTime?
  completedBy           String?
  consultationStatus    String?
  arrivedAt             DateTime?
  partialDispenseReason String?
  partialDispenseAt     DateTime?
  Doctor                Doctor?   @relation(fields: [doctorId], references: [id])
  Hospital              Hospital  @relation(fields: [hospitalId], references: [id])
  Patient               Patient   @relation(fields: [patientId], references: [id])
  Visit                 Visit?

  @@index([doctorId, dateTime])
  @@index([hospitalId, dateTime])
  @@index([patientId])
  @@index([status])
}

model AuditLog {
  id         String   @id
  userId     String
  entityType String
  entityId   String
  action     String
  oldValue   String?
  newValue   String?
  timestamp  DateTime @default(now())
  actionType String?
  hospitalId String?
  ipAddress  String?
  moduleName String?
  userName   String?
  User       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([hospitalId, timestamp])
  @@index([userId, timestamp])
}

model ChipOption {
  id         String    @id
  category   String
  value      String
  label      String
  hospitalId String?
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  Hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  @@unique([category, value, hospitalId])
  @@index([category, hospitalId])
}

model ColourVisionContrastSensitivity {
  id               String   @id
  visitId          String   @unique
  re               String?
  le               String?
  reviewedByDoctor Boolean  @default(false)
  updatedAt        DateTime
  Visit            Visit    @relation(fields: [visitId], references: [id])
}

model CounsellingRecord {
  id                       String    @id
  visitId                  String    @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  paymentType              String?
  paymentMode              String?
  schemeName               String?
  schemeType               String?
  outOfPocket              String?
  iolType                  String?
  iolLensName              String?
  iolPower                 String?
  iolBrand                 String?
  iolToric                 Boolean   @default(false)
  laterality               String?
  procedure                String?
  anaesthesia              String?
  estimateAmount           Decimal?  @db.Decimal(10, 2)
  estimateVague            Boolean   @default(false)
  fitForSurgery            Boolean   @default(false)
  advancePaid              Decimal?  @db.Decimal(10, 2)
  dateOfSurgery            DateTime?
  eligibleForSurgery       Boolean   @default(false)
  additionalInvestigations Boolean   @default(false)
  investigationDetails     String?
  surgeryDeferred          Boolean   @default(false)
  deferralReason           String?
  deferralNotes            String?
  status                   String    @default("DRAFT")
  submittedAt              DateTime?
  doctorDecision           String?
  doctorDecisionNotes      String?
  doctorReviewedAt         DateTime?
  confirmedAt              DateTime?
  policyNumber             String?
  Visit                    Visit     @relation(fields: [visitId], references: [id])
}

model DataRightsRequest {
  id          String    @id
  patientId   String
  type        String
  description String?
  status      String    @default("PENDING")
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Patient     Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, type])
  @@index([status, createdAt])
}

model DemoRequest {
  id             String   @id
  fullName       String
  email          String
  phone          String
  clinicName     String?
  specialization String?
  city           String?
  preferredDate  String?
  preferredTime  String?
  message        String?
  status         String   @default("NEW")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

model Diagnosis {
  id           String    @id
  visitId      String
  icd10Code    String
  description  String
  status       String    @default("ACTIVE")
  laterality   String?
  provisional  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?
  protocolId   String?
  protocolName String?
  Visit        Visit     @relation(fields: [visitId], references: [id])

  @@index([visitId])
}

model DiplopiaChart {
  id        String   @id
  visitId   String   @unique
  grid      String
  updatedAt DateTime
  Visit     Visit    @relation(fields: [visitId], references: [id])
}

model Dispense {
  id             String   @id
  visitId        String   @unique
  shortSummary   String
  longSummaryUrl String?
  createdAt      DateTime @default(now())
  Visit          Visit    @relation(fields: [visitId], references: [id])
}

model Doctor {
  id                        String                      @id
  userId                    String                      @unique
  name                      String
  specialty                 String                      @default("")
  contact                   String?
  credentials               String?
  createdAt                 DateTime                    @default(now())
  shortCode                 String?                     @unique
  email                     String?
  experience                String?
  medicalRegNumber          String?
  qualifications            String?
  signatureUrl              String?
  Appointment               Appointment[]
  User                      User                        @relation(fields: [userId], references: [id])
  DoctorAvailability        DoctorAvailability[]
  DoctorHospitalLink        DoctorHospitalLink[]
  DoctorLeave               DoctorLeave[]
  GeneratedSchedule         GeneratedSchedule[]
  IndividualDayAvailability IndividualDayAvailability[]
  MonthlyAvailability       MonthlyAvailability[]
  Patient                   Patient[]
  PluginLicense             PluginLicense[]
  PluginRegistration        PluginRegistration[]
  PostOpReview              PostOpReview[]
  Refractionist             Refractionist[]
  ScheduleException         ScheduleException[]
  SurgerySchedule           SurgerySchedule[]
  TenantLicense             TenantLicense?
  Visit                     Visit[]
}

model DoctorAvailability {
  id          String   @id
  doctorId    String
  hospitalId  String
  weekday     Int
  startTime   String
  endTime     String
  slotMins    Int      @default(15)
  createdAt   DateTime @default(now())
  maxPatients Int      @default(5)
  status      String   @default("ACTIVE")
  Doctor      Doctor   @relation(fields: [doctorId], references: [id])
  Hospital    Hospital @relation(fields: [hospitalId], references: [id])
}

model DoctorHospitalLink {
  id         String   @id
  doctorId   String
  hospitalId String
  active     Boolean  @default(true)
  Doctor     Doctor   @relation(fields: [doctorId], references: [id])
  Hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([doctorId, hospitalId])
  @@index([hospitalId])
}

model DoctorLeave {
  id         String    @id
  doctorId   String
  hospitalId String?
  date       DateTime
  leaveType  String    @default("FULL_DAY")
  halfPeriod String?
  reason     String?
  status     String    @default("APPROVED")
  createdAt  DateTime  @default(now())
  Doctor     Doctor    @relation(fields: [doctorId], references: [id])
  Hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, date])
}

model EmailOtp {
  id         String    @id
  email      String
  otpHash    String
  loginToken String?   @unique
  tokenExpAt DateTime?
  expiresAt  DateTime
  used       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model EmailVerification {
  id        String   @id
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model ExportOtp {
  id        String   @id
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model GeneralExamination {
  id                 String   @id
  visitId            String   @unique
  bp                 String?
  pulse              String?
  temperature        String?
  weight             String?
  chiefComplaint     String?
  hpi                String?
  provisionalDx      String?
  pastMedicalHistory String?
  pmhOtherText       String?
  medications        String?
  allergies          String?
  nkda               Boolean  @default(false)
  updatedAt          DateTime
  Visit              Visit    @relation(fields: [visitId], references: [id])
}

model GeneratedSchedule {
  id          String   @id
  doctorId    String
  date        DateTime
  hospitalId  String
  startTime   String
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  isModified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  Doctor      Doctor   @relation(fields: [doctorId], references: [id])
  Hospital    Hospital @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, date])
}

model HessChart {
  id             String   @id
  visitId        String   @unique
  grid           String
  interpretation String?
  updatedAt      DateTime
  Visit          Visit    @relation(fields: [visitId], references: [id])
}

model Hospital {
  id                        String                      @id
  name                      String
  shortCode                 String                      @unique
  address                   String?
  contact                   String?
  retentionYears            Int                         @default(7)
  createdAt                 DateTime                    @default(now())
  email                     String?
  logoUrl                   String?
  Appointment               Appointment[]
  ChipOption                ChipOption[]
  DoctorAvailability        DoctorAvailability[]
  DoctorHospitalLink        DoctorHospitalLink[]
  DoctorLeave               DoctorLeave[]
  GeneratedSchedule         GeneratedSchedule[]
  HospitalIntegration       HospitalIntegration?
  HospitalStaff             HospitalStaff[]
  IndividualDayAvailability IndividualDayAvailability[]
  InsuranceClaim            InsuranceClaim[]
  InsuranceCompany          InsuranceCompany[]
  InsurancePreAuthorization InsurancePreAuthorization[]
  IntegrationLog            IntegrationLog[]
  MonthlyAvailability       MonthlyAvailability[]
  Patient                   Patient[]
  PatientInsurance          PatientInsurance[]
  PluginConfig              PluginConfig[]
  Refractionist             Refractionist[]
  ScheduleException         ScheduleException[]
  SurgerySchedule           SurgerySchedule[]
  Visit                     Visit[]
}

model HospitalIntegration {
  id                   String           @id
  hospitalId           String           @unique
  integrationType      String           @default("REST")
  apiEndpoint          String?
  authType             String           @default("NONE")
  credentialsEncrypted String?
  oauthTokenUrl        String?
  fieldMappingJson     String?
  transformationRules  String?
  syncEnabled          Boolean          @default(false)
  maxRetries           Int              @default(3)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  Hospital             Hospital         @relation(fields: [hospitalId], references: [id])
  IntegrationLog       IntegrationLog[]
}

model HospitalStaff {
  id         String   @id
  userId     String   @unique
  hospitalId String
  name       String
  mobile     String?
  createdAt  DateTime @default(now())
  Hospital   Hospital @relation(fields: [hospitalId], references: [id])
  User       User     @relation(fields: [userId], references: [id])

  @@index([hospitalId])
}

model IOPReading {
  id               String   @id
  visitId          String
  re               Float?
  le               Float?
  method           String?
  takenAt          DateTime @default(now())
  source           String   @default("DOCTOR")
  reviewedByDoctor Boolean  @default(false)
  Visit            Visit    @relation(fields: [visitId], references: [id])

  @@index([visitId])
}

model IndividualDayAvailability {
  id          String   @id
  doctorId    String
  hospitalId  String
  date        DateTime
  startTime   String
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  reason      String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  Doctor      Doctor   @relation(fields: [doctorId], references: [id])
  Hospital    Hospital @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, hospitalId, date])
}

model InsuranceClaim {
  id                        String                     @id
  claimNumber               String                     @unique
  hospitalId                String
  patientInsuranceId        String
  insuranceCompanyId        String
  preAuthId                 String?                    @unique
  roomCharges               Float                      @default(0)
  surgeryCharges            Float                      @default(0)
  pharmacyCharges           Float                      @default(0)
  labCharges                Float                      @default(0)
  miscCharges               Float                      @default(0)
  totalBillAmount           Float                      @default(0)
  approvedAmount            Float?
  patientResponsibility     Float?
  status                    String                     @default("CREATED")
  submittedAt               DateTime?
  approvedAt                DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime
  Hospital                  Hospital                   @relation(fields: [hospitalId], references: [id])
  InsuranceCompany          InsuranceCompany           @relation(fields: [insuranceCompanyId], references: [id])
  PatientInsurance          PatientInsurance           @relation(fields: [patientInsuranceId], references: [id])
  InsurancePreAuthorization InsurancePreAuthorization? @relation(fields: [preAuthId], references: [id])
  InsuranceClaimDocument    InsuranceClaimDocument[]
  InsurancePayment          InsurancePayment[]
  InsuranceQuery            InsuranceQuery[]
  InsuranceSettlement       InsuranceSettlement[]

  @@index([claimNumber])
  @@index([hospitalId, status])
}

model InsuranceClaimDocument {
  id             String         @id
  claimId        String
  docType        String
  fileName       String
  fileUrl        String
  uploadedBy     String
  uploadedAt     DateTime       @default(now())
  InsuranceClaim InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model InsuranceCompany {
  id                        String                      @id
  hospitalId                String
  name                      String
  contactPerson             String?
  email                     String?
  phone                     String?
  address                   String?
  tpaName                   String?
  active                    Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  InsuranceClaim            InsuranceClaim[]
  Hospital                  Hospital                    @relation(fields: [hospitalId], references: [id])
  InsurancePreAuthorization InsurancePreAuthorization[]
  PatientInsurance          PatientInsurance[]

  @@index([hospitalId, active])
}

model InsurancePayment {
  id                  String               @id
  claimId             String
  settlementId        String?
  amount              Float
  paymentDate         DateTime
  paymentMode         String               @default("BANK_TRANSFER")
  referenceNumber     String?
  notes               String?
  postedBy            String
  createdAt           DateTime             @default(now())
  InsuranceClaim      InsuranceClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  InsuranceSettlement InsuranceSettlement? @relation(fields: [settlementId], references: [id])

  @@index([claimId])
}

model InsurancePreAuthorization {
  id                 String           @id
  hospitalId         String
  patientInsuranceId String
  insuranceCompanyId String
  diagnosis          String
  plannedSurgery     String?
  estimatedCost      Float
  requestedAmount    Float
  approvedAmount     Float?
  authCode           String?
  status             String           @default("PENDING")
  notes              String?
  submittedAt        DateTime?
  respondedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  InsuranceClaim     InsuranceClaim?
  Hospital           Hospital         @relation(fields: [hospitalId], references: [id])
  InsuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  PatientInsurance   PatientInsurance @relation(fields: [patientInsuranceId], references: [id])
  SurgerySchedule    SurgerySchedule?

  @@index([hospitalId, status])
}

model InsuranceQuery {
  id             String         @id
  claimId        String
  queryBy        String         @default("INSURER")
  queryText      String
  responseText   String?
  status         String         @default("OPEN")
  raisedAt       DateTime       @default(now())
  respondedAt    DateTime?
  InsuranceClaim InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, status])
}

model InsuranceSettlement {
  id               String             @id
  claimId          String
  settledAmount    Float
  settledDate      DateTime
  referenceNumber  String?
  notes            String?
  createdAt        DateTime           @default(now())
  InsurancePayment InsurancePayment[]
  InsuranceClaim   InsuranceClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model IntegrationLog {
  id                  String              @id
  integrationId       String
  hospitalId          String
  patientId           String?
  visitId             String?
  recordType          String              @default("VISIT")
  status              String              @default("PENDING")
  requestPayload      String?
  responsePayload     String?
  errorMessage        String?
  retryCount          Int                 @default(0)
  triggeredBy         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  Hospital            Hospital            @relation(fields: [hospitalId], references: [id])
  HospitalIntegration HospitalIntegration @relation(fields: [integrationId], references: [id])

  @@index([createdAt])
  @@index([hospitalId, status])
  @@index([visitId])
}

model InvestigationOrder {
  id         String   @id
  visitId    String
  category   String
  testName   String
  priority   String   @default("ROUTINE")
  laterality String?
  notes      String?
  status     String   @default("ORDERED")
  resultRef  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Visit      Visit    @relation(fields: [visitId], references: [id])

  @@index([visitId])
}

model IssuedLicenseKey {
  id             String    @id
  key            String    @unique
  note           String?
  months         Int       @default(12)
  createdAt      DateTime  @default(now())
  usedAt         DateTime?
  usedByDoctorId String?
  revoked        Boolean   @default(false)

  @@index([usedAt])
}

model LacrimalSacSyringing {
  id        String   @id
  visitId   String   @unique
  re        String?
  le        String?
  updatedAt DateTime
  Visit     Visit    @relation(fields: [visitId], references: [id])
}

model LicenseEvent {
  id          String   @id
  action      String
  keyMasked   String?
  performedBy String?
  status      String
  detail      String?
  createdAt   DateTime @default(now())
  doctorId    String

  @@index([doctorId, createdAt])
}

model Medication {
  id           String   @id
  visitId      String
  drugName     String
  dosage       String?
  frequency    String?
  duration     String?
  instructions String?
  createdAt    DateTime @default(now())
  laterality   String?
  route        String?
  Visit        Visit    @relation(fields: [visitId], references: [id])

  @@index([visitId])
}

model MobileOtp {
  id         String    @id
  mobile     String
  otpHash    String
  loginToken String?   @unique
  tokenExpAt DateTime?
  expiresAt  DateTime
  used       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
}

model MonthlyAvailability {
  id          String   @id
  doctorId    String
  hospitalId  String
  validFrom   DateTime
  validTo     DateTime
  weekdays    String
  startTime   String
  endTime     String
  slotMins    Int      @default(15)
  maxPatients Int      @default(5)
  label       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  Doctor      Doctor   @relation(fields: [doctorId], references: [id])
  Hospital    Hospital @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, hospitalId])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  message   String
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model OtRecord {
  id                          String          @id
  surgeryScheduleId           String          @unique
  checkInTime                 DateTime?
  identityVerified            Boolean         @default(false)
  correctEyeVerified          Boolean         @default(false)
  surgeryTypeVerified         Boolean         @default(false)
  consentFormsVerified        Boolean         @default(false)
  implantAvailabilityVerified Boolean         @default(false)
  assistantSurgeon            String?
  anesthetist                 String?
  scrubNurse                  String?
  circulatingNurse            String?
  anesthesiaTypeRecorded      String?
  whoSignIn                   String?
  surgeryStartTime            DateTime?
  procedurePerformed          String?
  iolModel                    String?
  iolPower                    String?
  iolBatch                    String?
  iolSerial                   String?
  medicinesConsumed           String?
  intraopFindings             String?
  complications               String?
  intraopRemarks              String?
  surgeryEndTime              DateTime?
  operativeNotes              String?
  patientConditionOnTransfer  String?
  transferTime                DateTime?
  status                      String          @default("CHECKIN")
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime
  SurgerySchedule             SurgerySchedule @relation(fields: [surgeryScheduleId], references: [id])
  OtTimeline                  OtTimeline[]
}

model OtTimeline {
  id          String   @id
  otRecordId  String
  step        String
  action      String
  performedBy String
  performedAt DateTime @default(now())
  OtRecord    OtRecord @relation(fields: [otRecordId], references: [id])

  @@index([otRecordId, performedAt])
}

model PasswordResetToken {
  id         String    @id
  userId     String
  email      String
  otpHash    String
  resetToken String?   @unique
  expiresAt  DateTime
  tokenExpAt DateTime?
  usedAt     DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([resetToken])
}

model PastExternalVisit {
  id                 String    @id
  patientId          String
  sourceDate         DateTime?
  sourceHospital     String?
  extractedDiagnosis String?
  extractedTreatment String?
  scanFileRef        String?
  verificationStatus String    @default("PENDING_REVIEW")
  createdAt          DateTime  @default(now())
  label              String?
  Patient            Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

model Patient {
  id                String              @id
  udid              String?             @unique
  doctorId          String?
  registeredAtId    String?
  name              String
  age               Int
  sex               String
  mobile            String
  aadhaarEncrypted  String
  category          String              @default("GENERAL")
  address           String?
  city              String?
  state             String?
  pincode           String?
  complaint         String?
  createdAt         DateTime            @default(now())
  uhid              String?             @unique
  photoUrl          String?
  aadhaarPhotoUrl   String?
  notes             String?
  occupation        String?
  Appointment       Appointment[]
  DataRightsRequest DataRightsRequest[]
  PastExternalVisit PastExternalVisit[]
  Doctor            Doctor?             @relation(fields: [doctorId], references: [id])
  Hospital          Hospital?           @relation(fields: [registeredAtId], references: [id])
  PatientConsent    PatientConsent[]
  PatientInsurance  PatientInsurance[]
  SurgerySchedule   SurgerySchedule[]
  Visit             Visit[]

  @@index([category])
  @@index([createdAt])
  @@index([doctorId])
  @@index([mobile])
  @@index([registeredAtId])
}

model PatientConsent {
  id          String    @id
  patientId   String
  purpose     String    @default("TREATMENT")
  method      String    @default("ELECTRONIC")
  status      String    @default("GRANTED")
  noticeText  String?
  capturedBy  String?
  consentedAt DateTime  @default(now())
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  Patient     Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, consentedAt])
  @@index([patientId, status])
}

model PatientInsurance {
  id                        String                      @id
  hospitalId                String
  patientId                 String
  insuranceCompanyId        String
  policyNumber              String
  cardNumber                String?
  coveragePercent           Float                       @default(80)
  validFrom                 DateTime
  validTo                   DateTime
  status                    String                      @default("ACTIVE")
  cardImageUrl              String?
  notes                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  InsuranceClaim            InsuranceClaim[]
  InsurancePreAuthorization InsurancePreAuthorization[]
  Hospital                  Hospital                    @relation(fields: [hospitalId], references: [id])
  InsuranceCompany          InsuranceCompany            @relation(fields: [insuranceCompanyId], references: [id])
  Patient                   Patient                     @relation(fields: [patientId], references: [id])

  @@index([hospitalId, patientId])
  @@index([status])
}

model Permission {
  id             String           @id
  key            String           @unique
  label          String?
  RolePermission RolePermission[]
}

model PluginConfig {
  id         String   @id
  pluginId   String
  hospitalId String
  key        String
  value      Json
  updatedAt  DateTime
  Hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@unique([pluginId, hospitalId, key])
  @@index([pluginId, hospitalId])
}

model PluginLicense {
  id           String    @id
  pluginId     String
  doctorId     String
  status       String    @default("TRIAL")
  trialEndsAt  DateTime?
  expiresAt    DateTime?
  usageLimit   Int?
  usageCount   Int       @default(0)
  usageResetAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Doctor       Doctor    @relation(fields: [doctorId], references: [id])

  @@unique([pluginId, doctorId])
  @@index([doctorId, status])
}

model PluginRegistration {
  id          String       @id
  pluginId    String
  doctorId    String
  status      PluginStatus @default(INSTALLED)
  version     String
  installedAt DateTime     @default(now())
  updatedAt   DateTime
  Doctor      Doctor       @relation(fields: [doctorId], references: [id])

  @@unique([pluginId, doctorId])
  @@index([doctorId, status])
}

model PostOpReview {
  id                String          @id
  surgeryScheduleId String          @unique
  doctorId          String
  reVaUnaided       String?
  leVaUnaided       String?
  reBcva            String?
  leBcva            String?
  iopRe             String?
  iopLe             String?
  woundStatus       String?
  iolPosition       String?
  anteriorChamber   String?
  fundusNotes       String?
  complications     String?
  postOpMedications String?
  instructions      String?
  followUpDate      DateTime?
  reviewNotes       String?
  reviewedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Doctor            Doctor          @relation(fields: [doctorId], references: [id])
  SurgerySchedule   SurgerySchedule @relation(fields: [surgeryScheduleId], references: [id])
}

model PosteriorSegment {
  id        String   @id
  visitId   String   @unique
  re        String?
  le        String?
  notes     String?
  updatedAt DateTime
  Visit     Visit    @relation(fields: [visitId], references: [id])
}

model PreOpAssessment {
  id                 String          @id
  surgeryScheduleId  String          @unique
  hasDiabetes        Boolean         @default(false)
  hasHypertension    Boolean         @default(false)
  hasCardiacDisease  Boolean         @default(false)
  hasAsthma          Boolean         @default(false)
  hasKidneyDisease   Boolean         @default(false)
  otherConditions    String?
  currentMedications String?
  allergies          String?
  nkda               Boolean         @default(false)
  bloodSugarLevel    String?
  bpReading          String?
  ecgNormal          Boolean?
  investigationNotes String?
  asaGrade           String?
  anesthesiaFitness  String          @default("FIT")
  fitnessNotes       String?
  assessedBy         String?
  assessedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime
  SurgerySchedule    SurgerySchedule @relation(fields: [surgeryScheduleId], references: [id])
}

model Refractionist {
  id         String   @id
  userId     String   @unique
  name       String
  mobile     String?
  doctorId   String
  hospitalId String
  createdAt  DateTime @default(now())
  Doctor     Doctor   @relation(fields: [doctorId], references: [id])
  Hospital   Hospital @relation(fields: [hospitalId], references: [id])
  User       User     @relation(fields: [userId], references: [id])
}

model RefractiveCorrection {
  id               String   @id
  visitId          String   @unique
  re               String?
  le               String?
  sentToOpticals   Boolean  @default(false)
  reviewedByDoctor Boolean  @default(false)
  updatedAt        DateTime
  extraCorrections String?
  Visit            Visit    @relation(fields: [visitId], references: [id])
}

model Retinoscopy {
  id        String   @id
  visitId   String   @unique
  re        String?
  le        String?
  updatedAt DateTime
  Visit     Visit    @relation(fields: [visitId], references: [id])
}

model Role {
  id                String   @id
  name              String   @unique
  label             String
  description       String?
  isSystem          Boolean  @default(false)
  isActive          Boolean  @default(true)
  color             String   @default("#6366f1")
  createdAt         DateTime @default(now())
  createdByDoctorId String?
}

model RolePermission {
  id           String     @id
  role         String
  permissionId String
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model RolePermissionSeed {
  id            String   @id
  role          String
  permissionKey String
  seededAt      DateTime @default(now())

  @@unique([role, permissionKey])
}

model ScheduleException {
  id               String    @id
  doctorId         String
  date             DateTime
  type             String
  hospitalId       String?
  startTime        String?
  endTime          String?
  slotMins         Int?
  maxPatients      Int?
  reason           String?
  halfPeriod       String?
  isRecurring      Boolean   @default(false)
  recurringGroupId String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  Doctor           Doctor    @relation(fields: [doctorId], references: [id])
  Hospital         Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([doctorId, date])
}

model SurgeryConsent {
  id                    String          @id
  surgeryScheduleId     String          @unique
  patientName           String
  attendantName         String?
  relationship          String?
  surgeryExplained      Boolean         @default(false)
  risksExplained        Boolean         @default(false)
  alternativesExplained Boolean         @default(false)
  questionsAnswered     Boolean         @default(false)
  consentGiven          Boolean         @default(false)
  consentDate           DateTime        @default(now())
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  SurgerySchedule       SurgerySchedule @relation(fields: [surgeryScheduleId], references: [id])
}

model SurgerySchedule {
  id                        String                     @id
  patientId                 String
  hospitalId                String
  operatingSurgeonId        String
  department                String?
  surgeryName               String
  diagnosis                 String?
  procedure                 String?
  surgeryCategory           String
  urgencyType               String
  priority                  String
  plannedDateTime           DateTime
  otRoom                    String?
  estimatedDuration         Int?
  anesthetistName           String?
  nursingStaff              String?
  admissionDate             DateTime?
  paymentStatus             String?
  consentReceived           Boolean                    @default(false)
  reportsUploaded           Boolean                    @default(false)
  otAvailable               Boolean                    @default(false)
  bloodArranged             Boolean                    @default(false)
  patientInformed           Boolean                    @default(false)
  status                    String                     @default("PLANNED")
  remarks                   String?
  createdBy                 String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime
  caseStatus                String?
  caseClosedAt              DateTime?
  preAuthId                 String?                    @unique
  OtRecord                  OtRecord?
  PostOpReview              PostOpReview?
  PreOpAssessment           PreOpAssessment?
  SurgeryConsent            SurgeryConsent?
  Hospital                  Hospital                   @relation(fields: [hospitalId], references: [id])
  Doctor                    Doctor                     @relation(fields: [operatingSurgeonId], references: [id])
  Patient                   Patient                    @relation(fields: [patientId], references: [id])
  InsurancePreAuthorization InsurancePreAuthorization? @relation(fields: [preAuthId], references: [id])

  @@index([hospitalId, plannedDateTime])
  @@index([patientId])
}

model TearFilm {
  id          String   @id
  visitId     String   @unique
  tbutRe      Float?
  tbutLe      Float?
  schirmer1Re Float?
  schirmer1Le Float?
  schirmer2Re Float?
  schirmer2Le Float?
  updatedAt   DateTime
  Visit       Visit    @relation(fields: [visitId], references: [id])
}

model TenantLicense {
  id                   String    @id
  trialStartsAt        DateTime  @default(now())
  trialEndsAt          DateTime
  plan                 String?
  subscriptionStartsAt DateTime?
  subscriptionEndsAt   DateTime?
  paymentStatus        String    @default("NONE")
  razorpayOrderId      String?
  razorpayPaymentId    String?
  razorpaySignature    String?
  remindersSent        Int       @default(0)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  licenseKey           String?
  machineId            String?
  deviceName           String?
  lastVerifiedAt       DateTime?
  doctorId             String    @unique
  signature            String?
  Doctor               Doctor    @relation(fields: [doctorId], references: [id])

  @@index([subscriptionEndsAt])
  @@index([trialEndsAt])
}

model User {
  id                 String               @id
  username           String               @unique
  passwordHash       String
  role               String
  email              String?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  AuditLog           AuditLog[]
  Doctor             Doctor?
  ExportOtp          ExportOtp[]
  HospitalStaff      HospitalStaff?
  Notification       Notification[]
  PasswordResetToken PasswordResetToken[]
  Refractionist      Refractionist?
  UserLoginHistory   UserLoginHistory[]
}

model UserLoginHistory {
  id           String    @id
  userId       String
  userName     String
  role         String
  hospitalId   String?
  hospitalName String?
  loginAt      DateTime  @default(now())
  logoutAt     DateTime?
  ipAddress    String?
  userAgent    String?
  status       String    @default("SUCCESS")
  isActive     Boolean   @default(true)
  failReason   String?
  User         User      @relation(fields: [userId], references: [id])

  @@index([isActive])
  @@index([status, loginAt])
  @@index([userId, loginAt])
}

model Visit {
  id                              String                           @id
  patientId                       String
  doctorId                        String
  hospitalId                      String
  appointmentId                   String?                          @unique
  date                            DateTime                         @default(now())
  status                          String                           @default("IN_PROGRESS")
  visitType                       String                           @default("General OPD")
  sentToPharmacy                  Boolean                          @default(false)
  followUpDate                    DateTime?
  referralEnabled                 Boolean                          @default(false)
  referralNote                    String?
  finalizedAt                     DateTime?
  finalizedBy                     String?
  adviseNotes                     String?
  inViewOf                        String?
  gonioNotes                      String?
  anesthesiaType                  String?
  procedureLaterality             String?
  procedureName                   String?
  followUpCompleted               Boolean                          @default(false)
  followUpCancelledAt             DateTime?
  surgeryAdvised                  Boolean                          @default(false)
  advisedSurgeryName              String?
  advisedSurgeryEye               String?
  advisedSurgeryNotes             String?
  advisedSurgeryDate              DateTime?
  procedureNotes                  String?
  aiDraftConfirmedAt              DateTime?
  aiDraftText                     String?
  aiDraftType                     String?
  AnteriorSegment                 AnteriorSegment?
  ColourVisionContrastSensitivity ColourVisionContrastSensitivity?
  CounsellingRecord               CounsellingRecord?
  Diagnosis                       Diagnosis[]
  DiplopiaChart                   DiplopiaChart?
  Dispense                        Dispense?
  GeneralExamination              GeneralExamination?
  HessChart                       HessChart?
  IOPReading                      IOPReading[]
  InvestigationOrder              InvestigationOrder[]
  LacrimalSacSyringing            LacrimalSacSyringing?
  Medication                      Medication[]
  PosteriorSegment                PosteriorSegment?
  RefractiveCorrection            RefractiveCorrection?
  Retinoscopy                     Retinoscopy?
  TearFilm                        TearFilm?
  Appointment                     Appointment?                     @relation(fields: [appointmentId], references: [id])
  Doctor                          Doctor                           @relation(fields: [doctorId], references: [id])
  Hospital                        Hospital                         @relation(fields: [hospitalId], references: [id])
  Patient                         Patient                          @relation(fields: [patientId], references: [id])
  VisualAcuity                    VisualAcuity?

  @@index([doctorId])
  @@index([followUpDate])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status, date])
}

model VisualAcuity {
  id               String   @id
  visitId          String   @unique
  testMethod       String?
  re               String?
  le               String?
  reviewedByDoctor Boolean  @default(false)
  updatedAt        DateTime
  Visit            Visit    @relation(fields: [visitId], references: [id])
}

enum PluginStatus {
  INSTALLED
  ENABLED
  DISABLED
}
